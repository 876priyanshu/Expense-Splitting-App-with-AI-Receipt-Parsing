<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= groupName %> - Settlement Results</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen p-6 font-sans">
  <div class="max-w-6xl mx-auto">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8">
      <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight mb-2 sm:mb-0"><%= groupName %></h1>
      <a href="/dashboard" class="text-blue-600 hover:text-blue-800 font-medium text-sm transition-colors">
        &larr; Back to Dashboard
      </a>
    </div>

    <!-- Main Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- LEFT COLUMN: Actions & Raw Data -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Add Expense Card -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
          <h2 class="text-gray-900 text-lg font-semibold mb-4">Add Expense</h2>
          <form action="/settlement/<%= groupId %>/add-expense" method="POST" class="space-y-4">
            <input type="text" name="description" required placeholder="Description e.g. Dinner at Brown Burger"
              class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow">
            <div class="flex gap-4">
              <input type="number" name="amount" required placeholder="Amount (₹)" min="1"
                class="flex-1 border border-gray-300 rounded-lg px-4 py-2.5 text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow">
              <select name="paidBy" required
                class="flex-1 border border-gray-300 rounded-lg px-4 py-2.5 text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow">
                <option value="" disabled selected>Paid by...</option>
                <% members.forEach(m => { %>
                  <option value="<%= m._id %>"><%= m.name %></option>
                <% }) %>
              </select>
            </div>
            <button type="submit"
              class="w-full bg-blue-600 text-white font-semibold py-2.5 rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
              Add Expense
            </button>
          </form>
        </div>

        <!-- Expenses List -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
          <h2 class="text-gray-900 text-lg font-semibold mb-4">Group Expenses</h2>
          <% if (expenses.length === 0) { %>
            <p class="text-gray-500 text-sm py-4 text-center border-2 border-dashed border-gray-200 rounded-lg">No expenses logged yet.</p>
          <% } else { %>
            <div class="space-y-1">
              <% expenses.forEach(e => { %>
                <div class="flex items-center justify-between py-3 border-b border-gray-100 last:border-0 hover:bg-gray-50 px-2 rounded transition-colors">
                  <div>
                    <p class="text-gray-900 text-sm font-medium"><%= e.description %></p>
                    <p class="text-gray-500 text-xs mt-0.5">Paid by <span class="font-medium"><%= e.paidBy %></span></p>
                  </div>
                  <div class="text-right">
                    <p class="text-gray-900 text-sm font-bold">₹<%= e.amount %></p>
                    <span class="inline-block bg-amber-50 text-amber-700 text-[11px] font-semibold px-2.5 py-0.5 rounded-full mt-1 border border-amber-100">
                      <%= e.category %>
                    </span>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>

        <!-- Manage Members Setup (2 Columns internally) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Add Member -->
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h2 class="text-gray-900 text-lg font-semibold mb-4">Add Member</h2>
            <form action="/settlement/<%= groupId %>/add-member" method="POST" class="flex flex-col gap-3">
              <input type="email" name="email" required placeholder="Email address"
                class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-400 transition-shadow">
              <button type="submit"
                class="w-full bg-gray-800 text-white font-semibold py-2.5 rounded-lg hover:bg-gray-900 transition-colors shadow-sm">
                Send Invite
              </button>
            </form>
          </div>

          <!-- Members List -->
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h2 class="text-gray-900 text-lg font-semibold mb-4">Members (<%= members.length %>)</h2>
            <div class="space-y-1 h-32 overflow-y-auto pr-2">
              <% members.forEach(m => { %>
                <div class="flex items-center justify-between py-2 border-b border-gray-50 last:border-0">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center text-xs font-bold">
                      <%= m.name.charAt(0).toUpperCase() %>
                    </div>
                    <span class="text-gray-800 text-sm font-medium"><%= m.name %></span>
                  </div>
                  <form action="/settlement/<%= groupId %>/remove-member" method="POST">
                    <input type="hidden" name="userId" value="<%= m._id %>">
                    <input type="hidden" name="_method" value="DELETE">
                    <button type="submit" class="text-red-500 text-xs font-medium hover:text-red-700 hover:underline transition-colors" onclick="return confirm('Remove <%= m.name %> from group?')">
                      Remove
                    </button>
                  </form>
                </div>
              <% }) %>
            </div>
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN: Analytics, Balances, & Activity -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- AI Summary -->
        <div class="bg-blue-50 border-l-4 border-blue-500 rounded-xl p-5 shadow-sm">
          <p class="text-blue-700 text-xs font-bold uppercase tracking-wider mb-2 flex items-center gap-2">
            <span>⚡</span> Settlement Summary
          </p>
          <p class="text-gray-800 text-sm leading-relaxed font-medium"><%= aiSummary %></p>
        </div>

        <!-- AI Spending Insights (Interactive) -->
        <div class="bg-purple-50 border-l-4 border-purple-500 rounded-xl p-5 shadow-sm">
          <p class="text-purple-700 text-xs font-bold uppercase tracking-wider mb-3 flex items-center gap-2">
            <span>✨</span> AI Spending Insights
          </p>
          <div id="insight-box">
            <button id="generate-insights-btn" class="w-full bg-purple-600 hover:bg-purple-700 text-white text-sm font-semibold py-2.5 px-4 rounded-lg transition-colors shadow-sm flex items-center justify-center gap-2">
              Generate Financial Tip
            </button>
          </div>
        </div>

        <!-- Balances -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
          <h2 class="text-gray-900 text-lg font-semibold mb-4">Current Balances</h2>
          <div class="space-y-1">
            <% balances.forEach(b => { %>
              <div class="flex items-center justify-between py-2 border-b border-gray-100 last:border-0">
                <span class="text-gray-800 text-sm font-medium"><%= b.name %></span>
                <span class="text-sm font-bold <%= b.balance >= 0 ? 'text-emerald-600 bg-emerald-50 px-2 py-1 rounded-md' : 'text-red-600 bg-red-50 px-2 py-1 rounded-md' %>">
                  <%= b.balance >= 0 ? '+₹' : '-₹' %><%= Math.abs(b.balance) %>
                </span>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Settlements Needed -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
          <h2 class="text-gray-900 text-lg font-semibold mb-4">How to Settle Up</h2>
          <% if (transactions.length === 0) { %>
            <div class="bg-gray-50 rounded-lg p-4 text-center">
              <p class="text-gray-500 text-sm font-medium">Everyone is completely settled up! 🎉</p>
            </div>
          <% else { %>
            <div class="space-y-3">
              <% transactions.forEach(t => { %>
                <div class="flex items-center justify-between bg-blue-50/50 border border-blue-100 rounded-lg px-4 py-3 text-sm">
                  <div class="flex items-center gap-2">
                    <span class="text-gray-900 font-semibold"><%= t.fromName %></span>
                    <span class="text-gray-400">&rarr;</span>
                    <span class="text-gray-900 font-semibold"><%= t.toName %></span>
                  </div>
                  <span class="text-blue-700 font-bold bg-white px-2 py-1 rounded shadow-sm border border-blue-100">₹<%= t.amount %></span>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>

        <!-- Recent Activity -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
          <h2 class="text-gray-900 text-lg font-semibold mb-4">Recent Activity</h2>
          <% if (activityFeed.length === 0) { %>
            <p class="text-gray-500 text-sm italic">No recent activity.</p>
          <% } else { %>
            <div class="space-y-4 relative before:absolute before:inset-0 before:ml-2 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-slate-300 before:to-transparent">
              <% activityFeed.forEach(log => { %>
                <div class="relative flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class="w-2 h-2 bg-blue-500 rounded-full ring-4 ring-white z-10"></div>
                    <p class="text-gray-600 text-sm">
                      <span class="font-bold text-gray-900"><%= log.actorName %></span> <%= log.details %>
                    </p>
                  </div>
                  <span class="text-gray-400 text-xs font-medium whitespace-nowrap ml-4"><%= log.timeAgo %></span>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>

      </div>
    </div>
  </div>

  <!-- Interactive AI Insights Script -->
  <script>
    document.getElementById('generate-insights-btn').addEventListener('click', async (e) => {
      const btn = e.target;
      const box = document.getElementById('insight-box');
      const groupId = '<%= groupId %>';

      // 1. Set Loading State
      btn.innerHTML = `
        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Analyzing data...
      `;
      btn.disabled = true;
      btn.classList.add('opacity-80', 'cursor-not-allowed');

      try {
        // 2. Fetch from Backend Route
        const response = await fetch(`/api/insights/${groupId}`);
        
        if (!response.ok) {
          throw new Error('Network response was not ok');
        }
        
        const data = await response.json();
        
        // 3. Inject the text result seamlessly
        box.innerHTML = `<p class="text-gray-800 text-sm leading-relaxed font-medium animate-pulse-once">${data.insights}</p>`;
        
      } catch (err) {
        console.error(err);
        box.innerHTML = `
          <div class="text-red-600 text-sm font-medium flex items-center gap-2">
            <span>⚠️</span> Failed to load insights. Please try again.
          </div>`;
      }
    });
  </script>
  
  <style>
    /* Slight fade-in animation for the generated text */
    @keyframes pulse-once {
      0% { opacity: 0; transform: translateY(5px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .animate-pulse-once {
      animation: pulse-once 0.4s ease-out forwards;
    }
  </style>
</body>
</html>
