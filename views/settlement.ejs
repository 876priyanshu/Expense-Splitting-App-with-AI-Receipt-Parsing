<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= groupName %> - Splitwise</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 min-h-screen p-6">
  <div class="max-w-4xl mx-auto space-y-6">
    <!-- Back Link -->
    <a href="/dashboard?userId=<%= members[0] ? members[0]._id : '' %>" class="text-indigo-600 text-sm hover:underline">&larr; Back to Dashboard</a>
    
    <h1 class="text-2xl font-bold text-slate-800"><%= groupName %></h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Left Column: Add Expense, Expenses List, Add Member & Member List -->
      <div class="space-y-6">
        <!-- Add Expense -->
        <div class="bg-white rounded-md shadow-sm border border-slate-200 p-5">
          <h2 class="text-slate-800 text-base font-semibold mb-4 border-b border-slate-100 pb-2">Add Expense</h2>
          <form action="/settlement/<%= groupId %>/add-expense" method="POST" class="space-y-4">
            <div>
              <input type="text" name="description" required placeholder="Description (e.g. Dinner, Taxi)"
                class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:outline-none focus:border-indigo-500">
            </div>
            <div class="grid grid-cols-2 gap-3">
              <input type="number" step="0.01" name="amount" required placeholder="Amount (₹)"
                class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:outline-none focus:border-indigo-500">
              <select name="paidBy" class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:outline-none focus:border-indigo-500">
                <% members.forEach(m => { %>
                  <option value="<%= m._id %>"><%= m.name %></option>
                <% }) %>
              </select>
            </div>
            <button type="submit"
              class="w-full bg-indigo-600 text-white text-sm font-medium py-2 rounded hover:bg-indigo-700 transition">
              Add Expense
            </button>
          </form>
        </div>

        <!-- Group Expenses -->
        <div class="bg-white rounded-md shadow-sm border border-slate-200 p-5">
          <h2 class="text-slate-800 text-base font-semibold mb-4 border-b border-slate-100 pb-2">Group Expenses</h2>
          <% if (expenses && expenses.length > 0) { %>
            <div class="space-y-3 max-h-60 overflow-y-auto pr-1">
              <% expenses.forEach(exp => { %>
                <div class="flex justify-between items-center border-b border-slate-50 pb-2">
                  <div>
                    <p class="text-sm font-medium text-slate-800"><%= exp.description %></p>
                    <p class="text-xs text-slate-500">Paid by <%= exp.paidBy %></p>
                  </div>
                  <div class="text-right">
                    <p class="text-sm font-semibold text-slate-800">₹<%= exp.amount %></p>
                    <span class="text-[10px] uppercase bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded"><%= exp.category || 'Other' %></span>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="text-xs text-slate-500">No expenses recorded yet.</p>
          <% } %>
        </div>

        <!-- Add Member & Members List Side-by-Side -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Add Member by Name -->
          <div class="bg-white rounded-md shadow-sm border border-slate-200 p-5">
            <h2 class="text-slate-800 text-base font-semibold mb-4 border-b border-slate-100 pb-2">Add Member</h2>
            <form action="/settlement/<%= groupId %>/add-member" method="POST" class="flex flex-col gap-3">
              <input type="text" name="name" required placeholder="Member's name"
                class="w-full border border-slate-300 rounded px-3 py-2 text-sm focus:outline-none focus:border-indigo-500">
              <button type="submit"
                class="bg-slate-800 text-white text-sm font-medium py-2 px-4 rounded hover:bg-slate-900 transition">
                Add Member
              </button>
            </form>
          </div>

          <!-- Members List -->
          <div class="bg-white rounded-md shadow-sm border border-slate-200 p-5">
            <h2 class="text-slate-800 text-base font-semibold mb-4 border-b border-slate-100 pb-2">Members (<%= members.length %>)</h2>
            <div class="space-y-1 max-h-40 overflow-y-auto pr-2">
              <% members.forEach(m => { %>
                <div class="flex items-center justify-between py-1 border-b border-slate-50 last:border-0">
                  <span class="text-slate-700 text-sm"><%= m.name %></span>
                  <form action="/settlement/<%= groupId %>/remove-member" method="POST">
                    <input type="hidden" name="userId" value="<%= m._id %>">
                    <button type="submit" class="text-red-600 text-xs hover:underline" onclick="return confirm('Remove <%= m.name %>?')">
                      Remove
                    </button>
                  </form>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Summary, AI Insights, Balances, Settling -->
      <div class="space-y-6">
        <!-- Settlement Summary Banner -->
        <div class="bg-slate-900 text-white rounded-md p-4 shadow-sm">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Settlement Summary</h3>
          <p class="text-sm"><%= aiSummary %></p>
        </div>

        <!-- AI Spending Insights -->
        <div class="bg-indigo-50 border border-indigo-100 rounded-md p-5 shadow-sm space-y-3">
          <h3 class="text-indigo-900 text-sm font-bold uppercase tracking-wider">AI Spending Insights</h3>
          <div class="text-sm text-indigo-950 bg-white p-3 rounded border border-indigo-100">
            <%= spendingInsights %>
          </div>
        </div>

        <!-- Current Balances -->
        <div class="bg-white rounded-md shadow-sm border border-slate-200 p-5">
          <h3 class="text-slate-800 text-base font-semibold mb-3 border-b border-slate-100 pb-2">Current Balances</h3>
          <div class="space-y-2">
            <% if (balances && balances.length > 0) { %>
              <% balances.forEach(b => { %>
                <div class="flex justify-between items-center text-sm">
                  <span class="text-slate-700"><%= b.name %></span>
                  <span class="font-semibold <%= b.balance > 0 ? 'text-emerald-600' : b.balance < 0 ? 'text-rose-600' : 'text-slate-600' %>">
                    <%= b.balance > 0 ? `+₹${b.balance}` : b.balance < 0 ? `-₹${Math.abs(b.balance)}` : '₹0' %>
                  </span>
                </div>
              <% }) %>
            <% } else { %>
              <p class="text-xs text-slate-500">No balances calculated yet.</p>
            <% } %>
          </div>
        </div>

        <!-- How to Settle Up -->
        <div class="bg-white rounded-md shadow-sm border border-slate-200 p-5">
          <h3 class="text-slate-800 text-base font-semibold mb-3 border-b border-slate-100 pb-2">How to Settle Up</h3>
          <div class="space-y-2">
            <% if (transactions && transactions.length > 0) { %>
              <% transactions.forEach(t => { %>
                <div class="flex justify-between items-center text-sm bg-slate-50 p-2 rounded">
                  <span class="text-slate-700"><%= t.fromName %> &rarr; <%= t.toName %></span>
                  <span class="font-semibold text-slate-800">₹<%= t.amount %></span>
                </div>
              <% }) %>
            <% } else { %>
              <p class="text-xs text-slate-500 text-center py-2">Everyone is completely settled up.</p>
            <% } %>
          </div>
        </div>

        <!-- Recent Activity Feed -->
        <div class="bg-white rounded-md shadow-sm border border-slate-200 p-5">
          <h3 class="text-slate-800 text-base font-semibold mb-3 border-b border-slate-100 pb-2">Recent Activity</h3>
          <div class="space-y-2 max-h-40 overflow-y-auto pr-1">
            <% if (activityFeed && activityFeed.length > 0) { %>
              <% activityFeed.forEach(log => { %>
                <div class="text-xs border-b border-slate-50 pb-1.5 last:border-0 flex justify-between">
                  <span class="text-slate-700"><strong><%= log.actorName %></strong> <%= log.details %></span>
                  <span class="text-slate-400 shrink-0 ml-2"><%= log.timeAgo %></span>
                </div>
              <% }) %>
            <% } else { %>
              <p class="text-xs text-slate-500">No recent activity.</p>
            <% } %>
          </div>
        </div>

      </div>
    </div>
  </div>
</body>
</html>