<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>SplitWise AI - Login</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center px-4">
  <div class="bg-white p-8 rounded-md shadow w-full max-w-sm border border-gray-200">

    <h1 class="text-xl font-semibold text-gray-800 mb-1">SplitWise AI</h1>
    <p class="text-gray-500 text-sm mb-6">Log in to your account</p>

    <% if (error) { %>
      <div class="bg-red-50 border border-red-200 text-red-600 text-sm rounded px-3 py-2 mb-4">
        <%= error %>
      </div>
    <% } %>

    <form action="/login" method="POST" class="space-y-4">
      <div>
        <label class="block text-gray-700 text-sm mb-1">Email</label>
        <input type="email" name="email" required
          class="w-full border border-gray-300 rounded px-3 py-2 text-gray-700 focus:outline-none focus:border-blue-500">
      </div>
      <div>
        <label class="block text-gray-700 text-sm mb-1">Password</label>
        <input type="password" name="password" required
          class="w-full border border-gray-300 rounded px-3 py-2 text-gray-700 focus:outline-none focus:border-blue-500">
      </div>
      <button type="submit"
        class="w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700 transition">
        Login
      </button>
    </form>

    <p class="text-center text-sm text-gray-500 mt-5">
      No account? <a href="/signup" class="text-blue-600 hover:underline">Sign up</a>
    </p>
  </div>
</body>
</html>